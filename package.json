{
  "name": "agentowners",
  "version": "0.1.0",
  "private": true,
  "description": "CODEOWNERS for AI agents",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "eslint packages/*/src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "generate:schema": "pnpm build && node scripts/generate-json-schema.mjs",
    "verify:schema": "node scripts/generate-json-schema.mjs --check",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:packages": "node scripts/verify-packed-packages.mjs",
    "verify:packages:node22": "node scripts/verify-packed-packages.mjs --node-major 22",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm verify:schema && pnpm test && pnpm verify:release"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.9.6",
    "postcss": "^8.5.23",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.8",
      "esbuild@0.27.7": "0.28.1"
    }
  }
}
