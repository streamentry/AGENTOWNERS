{
  "name": "@agent-owners/core",
  "version": "0.1.0",
  "description": "Core policy engine for AGENTOWNERS",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamentry/AGENTOWNERS.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/streamentry/AGENTOWNERS#readme",
  "bugs": {
    "url": "https://github.com/streamentry/AGENTOWNERS/issues"
  },
  "keywords": ["ai-agents", "governance", "policy-engine", "github", "security"],
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "minimatch": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
