{
  "name": "@agent-owners/core",
  "version": "0.1.0",
  "description": "Core policy engine for AGENTOWNERS",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./schema.json": "./agentowners.schema.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamentry/AGENTOWNERS.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/streamentry/AGENTOWNERS#readme",
  "bugs": {
    "url": "https://github.com/streamentry/AGENTOWNERS/issues"
  },
  "keywords": [
    "ai-agents",
    "governance",
    "policy-engine",
    "github",
    "security"
  ],
  "files": [
    "dist",
    "agentowners.schema.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "js-yaml": "^4.3.0",
    "picomatch": "4.0.5",
    "zod": "^3.23.0",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "8.20.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
