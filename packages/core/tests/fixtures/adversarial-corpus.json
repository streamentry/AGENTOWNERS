    }
  },
  {
    "id": "malformed-detection-pattern",
    "invariant": "A malformed configured regex cannot abort evaluation or confer agent identity.",
    "outcome": "decision",
    "policy": {
      "version": 1,
      "agents": {
        "malformed-agent": {
          "match": {
            "bodyPatterns": ["["]
          }
        }
      },
      "defaults": {
        "unknown_agent": "block"
      }
    },
    "input": {
      "eventType": "pull_request.opened",
      "actor": "unrecognized-user",
      "changedFiles": ["src/index.ts"],
      "prBody": "ordinary body"
    },
    "expected": {
      "effect": "block",
      "riskScore": 20,
      "riskLevel": "low",
      "detectedActions": ["open_pr"],
      "matchedRuleEffects": []
    }
  },
  {
    "id": "empty-file-glob-fails-closed",
    "invariant": "An empty file glob cannot abort evaluation or match a changed path.",
    "outcome": "decision",
    "policy": {
      "version": 1,
      "defaults": {
        "unknown_agent": "block"
      },
      "rules": [
        {
          "name": "Empty file glob",
          "when": {
            "files": [""]
          },
          "effect": "allow",
          "reason": "This rule must never match an invalid pattern."
        }
      ]
    },
    "input": {
      "eventType": "pull_request.opened",
      "actor": "unrecognized-user",
      "changedFiles": ["src/index.ts"]
    },
    "expected": {
      "effect": "block",
      "riskScore": 20,
      "riskLevel": "low",
      "detectedActions": ["open_pr"],
      "matchedRuleEffects": []
    }
  },
  {
    "id": "duplicate-agent-action",
    "invariant": "The same action cannot be assigned twice within one agent action list.",
    "outcome": "validation_error",
    "policy": {
      "version": 1,
      "agents": {
        "duplicate-agent": {
          "match": {
            "actors": ["duplicate-agent[bot]"]
          },
          "allowed": ["modify_docs", "modify_docs"]
        }
      }
    },
    "expected": {
      "issuePath": ["agents", "duplicate-agent", "allowed"],
      "messageIncludes": "\"modify_docs\" is already assigned to allowed"
    }
  },
  {
    "id": "contradictory-agent-action",
    "invariant": "The same action cannot be both allowed and blocked for one agent.",
    "outcome": "validation_error",
    "policy": {
      "version": 1,
      "agents": {
        "contradictory-agent": {
          "match": {
            "actors": ["contradictory-agent[bot]"]
          },
          "allowed": ["modify_docs"],
          "blocked": ["modify_docs"]
        }
      }
    },
    "expected": {
      "issuePath": ["agents", "contradictory-agent", "blocked"],
      "messageIncludes": "\"modify_docs\" is already assigned to allowed"
    }
  },
  {
    "id": "compounded-risk-cap",
    "invariant": "Compounded dependency, workflow, auth, infrastructure, secret, size, and unknown-agent risk remains capped at 100.",
    "outcome": "decision",
    "policy": {
      "version": 1,
      "defaults": {
        "unknown_agent": "require_approval",
        "secrets": "block",
        "workflows": "block"
      }
    },
    "input": {
      "eventType": "pull_request.opened",
      "actor": "unrecognized-user",
      "changedFiles": [
        "package.json",
        ".github/workflows/ci.yml",
        "src/auth/session.ts",
        "infra/main.tf",
        ".env.production"
      ],
      "diffLinesCount": 1000
    },
    "expected": {
      "effect": "block",
      "riskScore": 100,
      "riskLevel": "critical",
      "detectedActions": [
        "open_pr",
        "modify_dependencies",
        "edit_workflows",
        "modify_auth",
        "modify_infra",
        "touch_secrets"
      ],
      "matchedRuleEffects": []
    }
  }
