[
  {
    "id": "self-asserted-agent-marker-remains-unknown",
    "invariant": "An untrusted pull request body marker cannot escape the unknown-agent default.",
    "outcome": "decision",
    "policy": {
      "version": 1,
      "defaults": {
        "unknown_agent": "block",
        "known_agent": "allow"
      }
    },
    "input": {
      "eventType": "pull_request.opened",
      "actor": "untrusted-human",
      "prBody": "Generated by Claude",
      "changedFiles": ["src/index.ts"]
    },
    "expected": {
      "effect": "block",
      "riskScore": 20,
      "riskLevel": "low",
      "detectedActions": ["open_pr"],
      "matchedRuleEffects": []
    }
  },
  {
    "id": "agent-block-overrides-repository-allow",
    "invariant": "Agent-specific block wins over a repository allow rule.",
    "outcome": "decision",
    "policy": {
      "version": 1,
      "agents": {
        "workflow-agent": {
          "match": {
            "actors": ["workflow-agent[bot]"]
          },
          "blocked": ["edit_workflows"]
        }
      },
      "rules": [
        {
          "name": "Allow workflow files",
          "when": {
            "changes_workflows": true
          },
          "effect": "allow",
          "reason": "Adversarial precedence fixture."
        }
      ]
    },
    "input": {
      "eventType": "pull_request.opened",
      "actor": "workflow-agent[bot]",
      "changedFiles": [".github/workflows/ci.yml"]
    },
    "expected": {
      "effect": "block",
      "riskScore": 100,
      "riskLevel": "critical",
      "detectedActions": ["open_pr", "edit_workflows"],
      "matchedRuleEffects": ["block", "allow"]
    }
  },
  {
    "id": "mixed-allowed-and-unlisted-actions",
    "invariant": "A partially allowed action set falls through to conservative known-agent defaults.",
    "outcome": "decision",
    "policy": {
      "version": 1,
      "agents": {
        "partial-agent": {
          "match": {
            "actors": ["partial-agent[bot]"]
          },
          "allowed": ["open_pr"]
        }
      },
      "defaults": {
        "known_agent": "require_approval"
      }
    },
    "input": {
      "eventType": "pull_request.opened",
      "actor": "partial-agent[bot]",
      "changedFiles": ["tests/policy.test.ts"]
    },
    "expected": {
      "effect": "require_approval",
      "riskScore": 10,
      "riskLevel": "low",
      "detectedActions": ["open_pr", "modify_tests"],
      "matchedRuleEffects": []
    }
  },
  {
    "id": "dotfile-secret",
