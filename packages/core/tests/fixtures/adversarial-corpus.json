  {
    "id": "windows-style-path-is-conservative",
    "invariant": "A Windows-style documentation path retains docs-only classification.",
    "outcome": "decision",
    "policy": {
      "version": 1,
      "agents": {
        "windows-agent": {
          "match": {
            "actors": ["windows-agent[bot]"]
          }
        }
      },
      "defaults": {
